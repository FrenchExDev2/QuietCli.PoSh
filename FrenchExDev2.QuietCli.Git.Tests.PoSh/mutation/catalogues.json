{
  "ExpectedCases": 44,
  "Catalogues": {
    "Revision": {
      "CasePrefix": "revision ",
      "Mutants": [
        {
          "Name": "scalar-boundary",
          "File": "GitScalarOutput.cs",
          "From": "block.Length > maximum - buffer.WrittenCount",
          "To": "block.Length >= maximum - buffer.WrittenCount"
        },
        {
          "Name": "scalar-lf",
          "File": "GitScalarOutput.cs",
          "From": "value = value[..^1]",
          "To": "value = value[..^2]"
        },
        {
          "Name": "scalar-false",
          "File": "GitScalarOutput.cs",
          "From": "\"false\" => false",
          "To": "\"false\" => true"
        },
        {
          "Name": "describe-tag",
          "File": "GitDescribeRecords.cs",
          "From": "record[..previous]",
          "To": "record[..final]"
        },
        {
          "Name": "describe-distance",
          "File": "GitDescribeRecords.cs",
          "From": "\"Distance\", distance",
          "To": "\"Distance\", distance + 1"
        },
        {
          "Name": "revision-input",
          "File": "GitRevisionNames.cs",
          "From": "record[..space]",
          "To": "record[(space + 1)..]"
        },
        {
          "Name": "revision-undefined",
          "File": "GitRevisionNames.cs",
          "From": "Equals(name, \"undefined\")",
          "To": "false"
        },
        {
          "Name": "shortlog-count",
          "File": "GitShortlogRecords.cs",
          "From": "\"Count\", count",
          "To": "\"Count\", count + 1"
        }
      ]
    },
    "PathQuery": {
      "CasePrefix": "pathquery ",
      "Mutants": [
        {
          "Name": "raw-old-mode",
          "File": "GitRawDiffRecords.cs",
          "From": "\"OldMode\", fields[0][1..]",
          "To": "\"OldMode\", fields[1]"
        },
        {
          "Name": "raw-rename-arity",
          "File": "GitRawDiffRecords.cs",
          "From": "status[0] is 'R' or 'C' ? 2 : 1",
          "To": "1"
        },
        {
          "Name": "raw-path",
          "File": "GitRawDiffRecords.cs",
          "From": "pending[\"Path\"] = GitRecords.Decode(record)",
          "To": "pending[\"Path\"] = \"changed\""
        },
        {
          "Name": "raw-score-bound",
          "File": "GitRawDiffRecords.cs",
          "From": "parsed > 100",
          "To": "parsed > 101"
        },
        {
          "Name": "attribute-value",
          "File": "GitPathCheckRecords.cs",
          "From": "\"Value\", GitRecords.Decode(fields[2])",
          "To": "\"Value\", GitRecords.Decode(fields[1])"
        },
        {
          "Name": "ignore-negation",
          "File": "GitPathCheckRecords.cs",
          "From": "line is not null && !negated",
          "To": "line is not null && negated"
        },
        {
          "Name": "stdin-path-framing",
          "File": "GitPathCheckRecords.cs",
          "From": "string.Join('\\0', paths)",
          "To": "string.Join('\\n', paths)"
        },
        {
          "Name": "mailmap-email",
          "File": "GitMailmapRecords.cs",
          "From": "record[(angle + 1)..(length - 1)]",
          "To": "record[angle..(length - 1)]"
        }
      ]
    },
    "Attribution": {
      "CasePrefix": "attribution ",
      "Mutants": [
        {
          "Name": "path-named-escape",
          "File": "GitQuotedPath.cs",
          "From": "(byte)'n' => 10",
          "To": "(byte)'n' => 13"
        },
        {
          "Name": "path-octal-weight",
          "File": "GitQuotedPath.cs",
          "From": "(item - '0') * 64",
          "To": "(item - '0') * 8"
        },
        {
          "Name": "blame-original-line",
          "File": "GitBlameRecords.cs",
          "From": "\"OriginalLine\", original",
          "To": "\"OriginalLine\", final"
        },
        {
          "Name": "blame-content-prefix",
          "File": "GitBlameRecords.cs",
          "From": "GitRecords.Decode(record[1..])",
          "To": "GitRecords.Decode(record)"
        },
        {
          "Name": "blame-incomplete-group",
          "File": "GitBlameRecords.cs",
          "From": "Remaining(data) != 0",
          "To": "false"
        },
        {
          "Name": "blame-group-counter",
          "File": "GitBlameRecords.cs",
          "From": "Remaining(data) - 1",
          "To": "Remaining(data)"
        },
        {
          "Name": "reflog-selector",
          "File": "GitReflogRecords.cs",
          "From": "GitRecords.Unwrap(fields[1])",
          "To": "GitRecords.Unwrap(fields[2])"
        },
        {
          "Name": "reflog-message",
          "File": "GitReflogRecords.cs",
          "From": "GitRecords.Unwrap(fields[4])",
          "To": "GitRecords.Unwrap(fields[3])"
        }
      ]
    },
    "Push": {
      "CasePrefix": "push ",
      "Mutants": [
        {
          "Name": "remote-case",
          "File": "GitPush.cs",
          "From": "StringComparison.OrdinalIgnoreCase",
          "To": "StringComparison.Ordinal"
        },
        {
          "Name": "remote-value",
          "File": "GitPush.cs",
          "From": "line[3..]",
          "To": "line[4..]"
        },
        {
          "Name": "cr-preservation",
          "File": "GitPush.cs",
          "From": "text.TrimEnd('\\r')",
          "To": "text"
        },
        {
          "Name": "flag-rejection",
          "File": "GitPush.cs",
          "From": "\" =*+!-\"",
          "To": "\" =*+-\""
        },
        {
          "Name": "acceptance",
          "File": "GitPush.cs",
          "From": "line[0] != '!'",
          "To": "line[0] == '!'"
        },
        {
          "Name": "source-boundary",
          "File": "GitPush.cs",
          "From": "line[2..colon]",
          "To": "line[1..colon]"
        },
        {
          "Name": "target-boundary",
          "File": "GitPush.cs",
          "From": "line[(colon + 1)..tab]",
          "To": "line[colon..tab]"
        },
        {
          "Name": "summary-boundary",
          "File": "GitPush.cs",
          "From": "line[(tab + 1)..]",
          "To": "line[tab..]"
        }
      ]
    },
    "Repository": {
      "CasePrefix": "repository ",
      "Mutants": [
        {
          "Name": "config-null",
          "File": "GitConfigRecords.cs",
          "From": "split >= 0",
          "To": "split < 0"
        },
        {
          "Name": "config-value",
          "File": "GitConfigRecords.cs",
          "From": "record[(split + 1)..]",
          "To": "record[split..]"
        },
        {
          "Name": "config-key",
          "File": "GitConfigRecords.cs",
          "From": "if (key.Length == 0)",
          "To": "if (false)"
        },
        {
          "Name": "remote-name",
          "File": "GitRemoteRecords.cs",
          "From": "record[..tab]",
          "To": "record[..(tab + 1)]"
        },
        {
          "Name": "remote-push",
          "File": "GitRemoteRecords.cs",
          "From": "direction = \"push\"",
          "To": "direction = \"fetch\""
        },
        {
          "Name": "remote-url",
          "File": "GitRemoteRecords.cs",
          "From": "suffix = 7",
          "To": "suffix = 8"
        },
        {
          "Name": "operation-success",
          "File": "GitOperationOutcome.cs",
          "From": "exitCode == 0",
          "To": "exitCode != 0"
        },
        {
          "Name": "operation-conflict",
          "File": "GitOperationOutcome.cs",
          "From": "conflicts > 0",
          "To": "conflicts < 0"
        }
      ]
    },
    "Query": {
      "CasePrefix": "query ",
      "Mutants": [
        {
          "Name": "object-algorithm",
          "File": "GitObjectRecords.cs",
          "From": "value.Length != 40 && value.Length != 64",
          "To": "value.Length != 40"
        },
        {
          "Name": "object-parents",
          "File": "GitObjectRecords.cs",
          "From": "fields.Skip(1)",
          "To": "fields.Skip(0)"
        },
        {
          "Name": "reference-peeled",
          "File": "GitReferenceRecords.cs",
          "From": ".EndsWith(\"^{}\"u8)",
          "To": ".EndsWith(\"!{}\"u8)"
        },
        {
          "Name": "reference-symbolic",
          "File": "GitReferenceRecords.cs",
          "From": "line[5..separator]",
          "To": "line[4..separator]"
        },
        {
          "Name": "index-stage",
          "File": "GitIndexRecords.cs",
          "From": "header[2][0] - '0'",
          "To": "header[2][0] - '0' + 1"
        },
        {
          "Name": "index-path",
          "File": "GitIndexRecords.cs",
          "From": "record[(tab + 1)..]",
          "To": "record[tab..]"
        },
        {
          "Name": "counter-value",
          "File": "GitObjectCounts.cs",
          "From": "counts[key] = count",
          "To": "counts[key] = count + 1"
        },
        {
          "Name": "version-value",
          "File": "GitVersionRecords.cs",
          "From": "text[12..]",
          "To": "text[11..]"
        }
      ]
    }
  }
}
