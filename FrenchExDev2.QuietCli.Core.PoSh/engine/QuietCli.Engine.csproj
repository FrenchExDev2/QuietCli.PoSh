<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RuntimeFrameworkVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0-rc.3.26522.148</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>QuietCli.Engine</AssemblyName>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>
  <ItemGroup><InternalsVisibleTo Include="QuietCli.Engine.Tests" /></ItemGroup>
  <ItemGroup><Content Include="../protocol.json" Link="protocol.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
