<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RuntimeFrameworkVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>QuietCli.Engine</AssemblyName>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>
  <ItemGroup><InternalsVisibleTo Include="QuietCli.Engine.Tests" /></ItemGroup>
  <ItemGroup>
    <!-- Compile-time only: the PowerShell host supplies the runtime assembly; the isolated engine never loads cmdlet types. -->
    <PackageReference Include="System.Management.Automation" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>
  <ItemGroup><Content Include="../protocol.json" Link="protocol.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
