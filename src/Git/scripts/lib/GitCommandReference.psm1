#requires -Version 7.6

function Get-QuietGitCommandReference {
    <#
    .SYNOPSIS
    Renders a source-bound, deterministic reference for every specialized Git handler.
    .PARAMETER ModuleDirectory
    Git source module containing the handler catalogue, contracts and implementation.
    .PARAMETER GuidancePath
    Inert JSON listing the documented forms, projections and limitations by command.
    .OUTPUTS
    A UTF-8/LF-ready Markdown string. The function performs no writes or native calls.
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$ModuleDirectory,
        [Parameter(Mandatory)][string]$GuidancePath
    )

    $utf8 = [Text.UTF8Encoding]::new($false, $true)
    $modulePath = 'src/Git/src/FrenchExDev2.QuietCli.Git.PoSh'
    $catalogue = [IO.File]::ReadAllText([IO.Path]::Combine($ModuleDirectory, 'metadata/Git.HandlerCatalogue.json'), $utf8) | ConvertFrom-Json -AsHashtable
    $contracts = [IO.File]::ReadAllText([IO.Path]::Combine($ModuleDirectory, 'metadata/Git.Contracts.json'), $utf8) | ConvertFrom-Json -AsHashtable
    $inventory = [IO.File]::ReadAllText([IO.Path]::Combine($ModuleDirectory, 'metadata/Git.Inventory.json'), $utf8) | ConvertFrom-Json -AsHashtable
    $guidance = [IO.File]::ReadAllText($GuidancePath, $utf8) | ConvertFrom-Json -AsHashtable
    if ($catalogue.Handlers -isnot [Collections.IDictionary] -or !$catalogue.Handlers.Count -or $guidance -isnot [Collections.IDictionary]) {
        throw 'GitCommandReferenceInvalidCatalogue'
    }

    $commands = [string[]]@($catalogue.Handlers.Keys)
    [Array]::Sort($commands, [StringComparer]::Ordinal)
    $missing = @($commands | Where-Object { $_ -cnotin $guidance.Keys })
    $unexpected = @($guidance.Keys | Where-Object { $_ -cnotin $commands })
    if ($missing.Count -or $unexpected.Count) {
        throw ('GitCommandReferenceCoverageMismatch: missing [' + ($missing -join ', ') + '], unexpected [' + ($unexpected -join ', ') + ']')
    }

    $handlers = [Collections.Generic.Dictionary[string, object]]::new([StringComparer]::Ordinal)
    $sourceFiles = @(Get-ChildItem -LiteralPath ([IO.Path]::Combine($ModuleDirectory, 'src')) -File -Filter '*.ps1')
    foreach ($source in $sourceFiles) {
        $tokens = $null
        $errors = $null
        $tree = [Management.Automation.Language.Parser]::ParseFile($source.FullName, [ref]$tokens, [ref]$errors)
        if ($errors.Count) { throw ('GitCommandReferenceInvalidSource: ' + $source.Name) }
        foreach ($node in $tree.EndBlock.Statements) {
            if ($node -isnot [Management.Automation.Language.FunctionDefinitionAst] -or $node.Name -cnotin $catalogue.Handlers.Values) { continue }
            if (!$handlers.TryAdd($node.Name, @{ File = $source.Name; Line = $node.Extent.StartLineNumber })) {
                throw ('GitCommandReferenceDuplicateHandler: ' + $node.Name)
            }
        }
    }

    $inputs = [Collections.Generic.List[string]]::new()
    foreach ($file in $sourceFiles + @(Get-ChildItem -LiteralPath ([IO.Path]::Combine($ModuleDirectory, 'engine')) -File -Filter '*.cs') +
        @(Get-ChildItem -LiteralPath ([IO.Path]::Combine($ModuleDirectory, 'metadata')) -File -Filter '*.json') +
        @(Get-Item -LiteralPath ([IO.Path]::Combine($ModuleDirectory, 'FrenchExDev2.QuietCli.Git.PoSh.psm1')))) {
        $relative = [IO.Path]::GetRelativePath($ModuleDirectory, $file.FullName).Replace('\', '/')
        $text = [IO.File]::ReadAllText($file.FullName, $utf8).Replace("`r`n", "`n")
        $hash = [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($utf8.GetBytes($text)))
        $inputs.Add("$relative $hash")
    }
    $inputs.Sort([StringComparer]::Ordinal)
    $fingerprint = [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($utf8.GetBytes($inputs -join "`n"))).ToLowerInvariant()
    $links = @{
        'RequestedFormat' = '[RequestedFormat](#requested-format)'
        'Local ref observation' = '[Local ref observation](#local-ref-observation)'
        'Local worktree observation' = '[Local worktree observation](#local-worktree-observation)'
        'Local index observation' = '[Local index observation](#local-index-observation)'
    }
    $lines = [Collections.Generic.List[string]]::new()
    $lines.AddRange([string[]]@(
        '# QuietCli Git command reference'
        ''
        '<!-- Generated by src/Git/scripts/Export-GitCommandReference.ps1. -->'
        ''
        "[Git module and examples](../$modulePath/README.md) · [Regenerate or check this page](scripts/Git/Export-GitCommandReference.md)"
        ''
        ('The companion registers {0} specialized command handlers. The inventory tracks stable Git `>={1}` and `<{2}`.' -f
            $commands.Count, $inventory.MinimumVersion, $inventory.MaximumVersionExclusive)
        ''
        'The forms below describe implemented result routes with representative argument patterns. The Git argument schema and installed version govern available options. Use `Get-QuietGitCoverage` to inspect inventory availability and qualification.'
        ''
        'Read Outcome, Completeness.Source, Completeness.Analysis and Error before using Data. Also check command-specific fields such as AnswerComplete, Found and OperationOutcome. Fields below describe Data. Command and GitVersion are common where present.'
        ''
        '## Command forms'
        ''
        '| Native Git form | Result fields or projection | Scope and limits |'
        '| --- | --- | --- |'
    ))

    foreach ($command in $commands) {
        $handler = [string]$catalogue.Handlers[$command]
        if (!$handlers.ContainsKey($handler)) { throw ("GitCommandReferenceHandlerMissing: $command ($handler)") }
        if ($contracts[$command].OutputSchema -isnot [string] -or !$contracts[$command].OutputSchema.Trim()) {
            throw ('GitCommandReferenceSchemaMissing: ' + $command)
        }
        $forms = $guidance[$command]
        if ($forms -isnot [array] -or !$forms.Count) { throw ('GitCommandReferenceFormsMissing: ' + $command) }
        $seen = [Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal)
        foreach ($form in $forms) {
            if ($form -isnot [Collections.IDictionary] -or $form.Count -ne 3) { throw ('GitCommandReferenceFormInvalid: ' + $command) }
            foreach ($property in 'Form', 'Data', 'Limits') {
                if ($form[$property] -isnot [string] -or !$form[$property].Trim() -or $form[$property] -match '[\r\n`|]') {
                    throw ("GitCommandReferenceFormInvalid: $command.$property")
                }
            }
            if ($form.Form -cnotmatch ('^' + [regex]::Escape($command) + '(?: |$)') -or !$seen.Add($form.Form)) {
                throw ('GitCommandReferenceFormInvalid: ' + $command)
            }
            $projection = if ($links.ContainsKey($form.Data)) { $links[$form.Data] } else {
                ($form.Data -split ', ' | ForEach-Object { '`' + $_ + '`' }) -join ', '
            }
            $lines.Add(('| `{0}` | {1} | {2} |' -f $form.Form, $projection, $form.Limits))
        }
    }

    $lines.AddRange([string[]]@(
        ''
        '## Shared result projections'
        ''
        '### Requested format'
        ''
        'OutputMode is RequestedFormat. Records contains the selected native records as UTF-8 text or an explicit byte representation. Delimiter identifies the record boundary. Pipes are required for byte record projections.'
        ''
        '### Local ref observation'
        ''
        'HeadBefore, HeadAfter, BranchBefore, BranchAfter, ReferenceChanges, ExitCode, OperationOutcome and Observation. The before/after reads are independent and cover local HEAD and refs.'
        ''
        '### Local worktree observation'
        ''
        'Before, After, Conflicts, ReferenceChanges, State, ExitCode, OperationOutcome and Observation. Before and After are local HEAD, index and worktree snapshots around one native operation. Ref changes are sampled for switch, reset, merge, rebase, cherry-pick and revert.'
        ''
        '### Local index observation'
        ''
        'Before and After are active index entries with stage, mode, object ID and path. ExitCode, OperationOutcome and Observation report native execution and snapshot availability. File contents and index flags outside those tuples are outside the projection.'
        ''
        '## Handler sources'
        ''
        '| Command | Declared schema | Handler |'
        '| --- | --- | --- |'
    ))
    foreach ($command in $commands) {
        $name = [string]$catalogue.Handlers[$command]
        $source = $handlers[$name]
        $lines.Add(('| `{0}` | `{1}` | [`{2}`](../{3}/src/{4}#L{5}) |' -f
            $command, $contracts[$command].OutputSchema, $name, $modulePath, $source.File, $source.Line))
    }
    $lines.AddRange([string[]]@(
        ''
        ('Source input SHA-256 `{0}`.' -f $fingerprint)
        ''
        '<!-- credits:begin -->'
        '## Credits'
        ''
        'This document is covered by the mandatory [CREDITS.md](../CREDITS.md), which records the licenses of all softwares which have QuietCli companions'
        '<!-- credits:end -->'
        ''
    ))
    return $lines -join "`n"
}

Export-ModuleMember -Function 'Get-QuietGitCommandReference'
