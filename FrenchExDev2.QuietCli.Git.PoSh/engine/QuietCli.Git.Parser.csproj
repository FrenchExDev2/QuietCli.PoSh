<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>QuietCli.Git.Parser</AssemblyName>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-time only: the PowerShell host supplies the runtime assembly. -->
    <PackageReference Include="System.Management.Automation" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
