function Invoke-QuietScriptSyncCredits {
#requires -Version 7.6
<#
.SYNOPSIS
Builds the root CREDITS.md file by aggregating every business module's LICENSE_CREDITS.md.
.DESCRIPTION
Part of the module contract: every business module discovered by Get-QuietWorkspaceProjects
(Core, Git, Vagrant - never a .Tests companion) must ship its own LICENSE_CREDITS.md declaring
the third-party license(s) its native dependency uses, with reference links. The generated file
opens with a table of contents linking each module's heading, so it stays navigable as new
business modules are added. This script never reads CREDITS.md as a source; it always
recomputes it from the modules and compares. Default (no
-Apply) mode only reports each module's and the root file's compliance state and writes nothing.
-Apply writes the regenerated CREDITS.md, honoring -WhatIf/-Confirm through SupportsShouldProcess.
-Apply -WhatIf previews exactly what -Apply would write.
.PARAMETER WorkspaceRoot
Monorepo containing the immediate FrenchExDev2.QuietCli.*.PoSh project directories. Defaults to
this script's workspace root.
.PARAMETER CreditsPath
Path to the generated CREDITS.md file. Defaults to CREDITS.md at the workspace root.
.PARAMETER Apply
Writes the regenerated CREDITS.md when it is missing or stale. Without this switch the script
only reports; it never writes.
.EXAMPLE
./scripts/Sync-Credits.ps1
Reports whether every business module ships LICENSE_CREDITS.md and whether CREDITS.md matches.
.EXAMPLE
./scripts/Sync-Credits.ps1 -Apply -WhatIf
Previews exactly what -Apply would write to CREDITS.md, without writing it.
.EXAMPLE
./scripts/Sync-Credits.ps1 -Apply
Regenerates CREDITS.md from every business module's LICENSE_CREDITS.md.
#>
[CmdletBinding(SupportsShouldProcess)]
param(
    [string]$WorkspaceRoot = (Split-Path ([IO.Path]::GetDirectoryName($PSScriptRoot)) -Parent),
    [string]$CreditsPath = ([IO.Path]::Combine((Split-Path ([IO.Path]::GetDirectoryName($PSScriptRoot)) -Parent),'CREDITS.md')),
    [switch]$Apply
)
$ErrorActionPreference = 'Stop'
Import-Module ([IO.Path]::Combine($PSScriptRoot,'WorkspaceProjects.psm1')) -DisableNameChecking -ErrorAction Stop

$beginPrefix = '<!-- module-credits:'
$beginSuffix = ':begin -->'
$endSuffix = ':end -->'

function Get-ModuleCreditsBlock {
    <#
    .SYNOPSIS
    Wraps one business module's LICENSE_CREDITS.md content in its regex-identifiable marker.
    .PARAMETER Name
    Module suite name (for example Core, Git, Vagrant), used verbatim in the marker.
    .PARAMETER Content
    Raw LICENSE_CREDITS.md content for that module.
    #>
    param([Parameter(Mandatory)][string]$Name, [Parameter(Mandatory)][string]$Content)
    $beginMarker = $beginPrefix + $Name + $beginSuffix
    $endMarker = $beginPrefix + $Name + $endSuffix
    return ($beginMarker + "`n" + $Content.Trim() + "`n" + $endMarker)
}

function Get-MarkdownHeadingAnchor {
    <#
    .SYNOPSIS
    Converts a Markdown heading's text into its GitHub-style anchor slug.
    .PARAMETER Heading
    Heading text, without the leading '#' markers.
    #>
    param([Parameter(Mandatory)][string]$Heading)
    $slug = $Heading.Trim().ToLowerInvariant()
    $slug = [regex]::Replace($slug, "[^\p{L}\p{Nd}\s-]", '')
    $slug = [regex]::Replace($slug, '\s+', '-')
    return $slug
}

$projects = @(Get-QuietWorkspaceProjects $WorkspaceRoot | Where-Object { -not $_.IsTest } | Sort-Object Suite)
if (-not $projects.Count) { throw 'WorkspaceBusinessModulesNotFound' }

$missing = [System.Collections.Generic.List[string]]::new()
$blocks = [System.Collections.Generic.List[string]]::new()
$tocEntries = [System.Collections.Generic.List[object]]::new()
foreach ($project in $projects) {
    $licensePath = [IO.Path]::Combine($project.Directory,'LICENSE_CREDITS.md')
    if (-not (Test-Path -LiteralPath $licensePath -PathType Leaf)) {
        $missing.Add($project.Name)
        continue
    }
    $moduleContent = Get-Content -LiteralPath $licensePath -Raw -Encoding UTF8
    $headingMatch = [regex]::Match($moduleContent, '(?m)^##\s+(.+?)\s*$')
    if (-not $headingMatch.Success) { throw "ModuleLicenseCreditsHeadingMissing: $($project.Name)" }
    $heading = $headingMatch.Groups[1].Value
    $tocEntries.Add([pscustomobject]@{ Heading = $heading; Anchor = (Get-MarkdownHeadingAnchor $heading) })
    $blocks.Add((Get-ModuleCreditsBlock -Name $project.Suite -Content $moduleContent))
}
if ($missing.Count) {
    throw ('ModuleLicenseCreditsMissing: ' + ($missing -join ', '))
}

$toc = (@('## Table of contents', '') + @($tocEntries | ForEach-Object { "- [$($_.Heading)](#$($_.Anchor))" }) + @('', '')) -join "`n"

$header = @(
    '# Credits and third-party licenses',
    '',
    '<!-- This file is generated by scripts/Sync-Credits.ps1 from every business module''s LICENSE_CREDITS.md. -->',
    '<!-- Do not hand-edit it; edit the owning module''s LICENSE_CREDITS.md and rerun the script. -->',
    '',
    'This file is mandatory. Every `docs/*.md` file links back to it from its own dedicated credits',
    'paragraph, checked and written by [`scripts/Sync-DocsCredits.ps1`](scripts/Sync-DocsCredits.ps1).',
    '',
    'This repository, its automation and its documentation rely on the following third-party',
    'projects, one per business module. Each one is distributed under its own license, reproduced',
    'at the links below; this file does not relicense or supersede them.',
    '',
    ''
) -join "`n"

$expectedContent = $header + $toc + (($blocks.ToArray()) -join "`n`n") + "`n"

$existingContent = if (Test-Path -LiteralPath $CreditsPath -PathType Leaf) { Get-Content -LiteralPath $CreditsPath -Raw -Encoding UTF8 } else { $null }
$state = if ($null -eq $existingContent) { 'Missing' } elseif ($existingContent.Trim() -ne $expectedContent.Trim()) { 'Stale' } else { 'UpToDate' }

$report = [pscustomobject]@{ Path = $CreditsPath; Modules = @($projects.Suite); State = $state }

if ($state -ne 'UpToDate' -and $Apply -and $PSCmdlet.ShouldProcess($CreditsPath, "Write regenerated CREDITS.md ($state)")) {
    [System.IO.File]::WriteAllText($CreditsPath, $expectedContent, [System.Text.UTF8Encoding]::new($false))
    $report.State = "$state (Applied)"
}

$report
if ($report.State -notin 'UpToDate' -and $report.State -notlike '* (Applied)') {
    throw "CreditsNonCompliant: $($report.State)"
}

}
Export-ModuleMember -Function 'Invoke-QuietScriptSyncCredits'
