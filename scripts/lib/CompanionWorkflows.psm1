#requires -Version 7.6

Import-Module ([IO.Path]::Combine($PSScriptRoot,'WorkspaceLayout.psm1')) -DisableNameChecking -ErrorAction Stop
Import-Module ([IO.Path]::Combine($PSScriptRoot,'WorkspaceProjects.psm1')) -DisableNameChecking -ErrorAction Stop
Import-Module ([IO.Path]::Combine($PSScriptRoot,'CiCompanions.psm1')) -DisableNameChecking -ErrorAction Stop

function Get-QuietCompanionProfiles {
    <#
    .SYNOPSIS
    Derives explicit workflow parameters from discovered groups and the qualification catalogue.
    .PARAMETER WorkspaceRoot
    Selected checkout.
    #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$WorkspaceRoot)
    $modules=@(Get-QuietWorkspaceProjects $WorkspaceRoot)
    if(!(Get-QuietCiCompanionCataloguePath $WorkspaceRoot)){
        if(@($modules|Where-Object {$_.Path.StartsWith('src/',[StringComparison]::Ordinal)}).Count){throw 'CompanionCiCatalogueRequired'}
        return # Isolated legacy manifest fixtures do not declare CI profiles.
    }
    $configuration=Read-QuietCiCompanions $WorkspaceRoot
    foreach($group in @($modules.SolutionGroup|Sort-Object -Unique)){
        $members=@($modules|Where-Object SolutionGroup -CEQ $group)
        $product=$configuration.Companions.Contains($group)
        $declaration=if($product){$configuration.Companions[$group]}
        if(!$product -and $group -cnotin @('Tooling','Distribution')){throw ('CompanionCiProfileMissing: '+$group)}
        $file=if($product){'ci.yml'}elseif($group -ceq 'Tooling'){'tooling-component-ci.yml'}else{'distribution-ci.yml'}
        [pscustomobject]@{
            Suite=$group;Root='src/'+$group;SolutionPath='src/'+$group+'/'+$group+'.slnx'
            SourcePath=$(if($declaration.SourcePath){$declaration.SourcePath.Substring(0,$declaration.SourcePath.LastIndexOf('/'))}elseif(@($members|Where-Object {!$_.IsTest}).Count){'src/'+$group+'/src'}else{''})
            TestPath=$(if($declaration.TestPath){$declaration.TestPath.Substring(0,$declaration.TestPath.LastIndexOf('/'))}else{'src/'+$group+'/test'});Workflow='.github/workflows/'+$file
            Engine=$(if($product){'ci.yml'}else{'workspace-component-ci.yml'})
            Sources=@($members|Where-Object {!$_.IsTest}|ForEach-Object {$_.Path});Tests=@($members|Where-Object IsTest|ForEach-Object {$_.Path})
            CollectPerformance=($product -and @($configuration.Suites.Values|Where-Object {$_.Group -ceq $group -and $_.CoreEvidence}).Count -gt 0)
        }
    }
}

function Get-QuietCompanionWorkflowDefinitions {
    <#
    .SYNOPSIS
    Renders dedicated Tooling and Distribution workflow entry points.
    .PARAMETER WorkspaceRoot
    Checkout providing the profiles.
    #>
    param([Parameter(Mandatory)][string]$WorkspaceRoot)
    $template=@'
# Generated by Sync-CompanionWorkflows.ps1; change the catalogue, then regenerate.
name: QuietCli %SUITE%
on:
  workflow_call:
    inputs:
      qualification_mode:
        type: string
        required: false
        default: full
  workflow_dispatch:
    inputs:
      qualification_mode:
        type: choice
        options: [full, smoke, build]
        default: full
permissions:
  contents: read

jobs:
  qualify:
    uses: ./.github/workflows/%ENGINE%
    with:
      suite: %SUITE%
      solution_path: '%SOLUTION%'
      source_path: '%SOURCE%'
      test_path: '%TEST%'
      qualification_mode: %MODE%
'@
    foreach($profile in Get-QuietCompanionProfiles $WorkspaceRoot | Where-Object Engine -CEQ 'workspace-component-ci.yml'){
        $content=$template.Replace('%SUITE%',$profile.Suite).Replace('%ENGINE%',$profile.Engine).Replace('%SOLUTION%',$profile.SolutionPath).Replace('%SOURCE%',$profile.SourcePath).Replace('%TEST%',$profile.TestPath).Replace('%MODE%',('$'+'{{ inputs.qualification_mode || ''full'' }}')).TrimEnd()+[char]10
        [pscustomobject]@{Path=$profile.Workflow;Content=$content;Profile=$profile}
    }
}

function Sync-QuietCompanionWorkflows {
    <#
    .SYNOPSIS
    Checks workflow drift or writes YAML without changing documentation review receipts.
    .PARAMETER WorkspaceRoot
    Selected checkout.
    .PARAMETER Apply
    Writes generated YAML. Default checks without writes.
    #>
    [CmdletBinding(SupportsShouldProcess)]
    param([Parameter(Mandatory)][string]$WorkspaceRoot,[switch]$Apply)
    # The generated workflows warm only overlay images; a companion image outside that contract fails first.
    # Without a catalogue there is no image to check: profiles then either reject a grouped workspace
    # (CompanionCiCatalogueRequired) or, for a legacy fixture, declare nothing.
    if(Get-QuietCiCompanionCataloguePath $WorkspaceRoot){
        $configuration=Read-QuietCiCompanions $WorkspaceRoot
        $null=Assert-QuietCiCompanionImages -WorkspaceRoot $WorkspaceRoot -Configuration $configuration
        if([IO.Path]::GetFileName($configuration.Path) -ceq 'companions.yaml'){
            Import-Module ([IO.Path]::Combine($PSScriptRoot,'PullRequestChecklist.psm1')) -DisableNameChecking -ErrorAction Stop
            $templatePath=[IO.Path]::Combine($WorkspaceRoot,'.github','pull_request_template.md')
            $current=[IO.File]::ReadAllText($templatePath,[Text.Encoding]::UTF8).Replace("`r`n","`n")
            $expected=Expand-QuietPullRequestTemplate -Template $current -Configuration $configuration
            if($expected -cne $current){
                if(!$Apply){throw 'CompanionPullRequestTemplateDrift'}
                if($PSCmdlet.ShouldProcess($templatePath,'Synchronize the companion checkboxes')){
                    [IO.File]::WriteAllText($templatePath,$expected,[Text.UTF8Encoding]::new($false))
                }
            }
        }
    }
    foreach($entry in Get-QuietCompanionWorkflowDefinitions $WorkspaceRoot){
        $path=(Resolve-QuietWorkspacePath -WorkspaceRoot $WorkspaceRoot -RelativePath $entry.Path)
        if((Test-Path -LiteralPath $path) -and [IO.File]::ReadAllText($path,[Text.Encoding]::UTF8) -ceq $entry.Content){continue}
        if(!$Apply){throw ('CompanionWorkflowDrift: '+$entry.Path)}
        if($PSCmdlet.ShouldProcess($path,'Synchronize companion workflow')){
            [void][IO.File]::WriteAllTextAsync($path,$entry.Content,[Text.UTF8Encoding]::new($false)).GetAwaiter().GetResult()
        }
    }
}

function Assert-QuietCompanionProfile {
    <#
    .SYNOPSIS
    Rejects caller paths that disagree with the discovered companion profile.
    .PARAMETER WorkspaceRoot
    Selected checkout.
    .PARAMETER Suite
    Discovered companion or explicit All.
    .PARAMETER SolutionPath
    Optional explicit solution path.
    .PARAMETER SourcePath
    Optional explicit source container.
    .PARAMETER TestPath
    Optional explicit test container.
    #>
    param([Parameter(Mandatory)][string]$WorkspaceRoot,[Parameter(Mandatory)][string]$Suite,[string]$SolutionPath,[string]$SourcePath,[string]$TestPath)
    if($Suite -ceq 'All'){if($SolutionPath -or $SourcePath -or $TestPath){throw 'AllDoesNotHaveCompanionPaths'};return}
    $profile=@(Get-QuietCompanionProfiles $WorkspaceRoot|Where-Object Suite -CEQ $Suite)
    if($profile.Count -ne 1){throw ('CompanionProfileUnknown: '+$Suite)}
    foreach($name in @('SolutionPath','SourcePath','TestPath')){
        $value=Get-Variable -Name $name -ValueOnly
        if($value -and $value -cne $profile[0].$name){throw ('CompanionProfilePathMismatch: '+$name)}
    }
}
Export-ModuleMember -Function Get-QuietCompanionProfiles,Get-QuietCompanionWorkflowDefinitions,Sync-QuietCompanionWorkflows,Assert-QuietCompanionProfile
